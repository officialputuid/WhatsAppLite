{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp Lite",
  "version": "0.1.1",
  "identifier": "com.officialputuid.whatsapplite",
  "build": {
    "frontendDist": "assets"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
